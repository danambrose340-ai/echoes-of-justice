{
  "name": "echoes-of-justice",
  "version": "2.0.0",
  "description": "Victim advocacy website for the Colorado community - Next.js + FastAPI",
  "keywords": [
    "victim-advocacy",
    "justice",
    "community",
    "colorado"
  ],
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "next lint",
    "lint:html": "npx html-validate index.html 2>/dev/null || echo 'html-validate not installed'",
    "lint:css": "npx stylelint assets/css/style.css --config .stylelintrc.json 2>/dev/null || echo 'stylelint not installed'",
    "lint:js": "npx eslint assets/js/app.js --config .eslintrc.json 2>/dev/null || echo 'eslint not installed'",
    "test:accessibility": "npx pa11y index.html --config .pa11yci.json 2>/dev/null || echo 'pa11y not installed'",
    "test:unit": "npx jest tests/js/app.test.js",
    "security:scan-ci": "npx audit-ci --low 2>/dev/null || echo 'audit-ci not installed'",
    "security:scan-local": "npm audit",
    "deploy:static": "./deploy.sh",
    "deploy:production": "./deploy.sh production",
    "deploy:staging": "./deploy.sh staging",
    "clean": "rm -rf dist/* .next",
    "docs": "echo 'Documentation in docs/ directory'"
  },
  "dependencies": {
    "@babel/runtime-corejs2": "^7.29.7",
    "next": "14.2.35",
    "next-seo": "^2.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.2.35",
    "html-validate": "^9.0.0",
    "jest": "^29.0.0",
    "live-server": "^1.2.0",
    "pa11y": "^9.0.0",
    "postcss": "^8.4.39",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "Echoes of Justice Team",
  "license": "MIT"
}
